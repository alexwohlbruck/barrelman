# Copy to .env and adjust for your machine.
#
# Only needed when driving Pelias from THIS directory with the `pelias` CLI
# (provisioning: download / prepare polylines / import). Running it as part of
# the barrelman stack — `docker compose --profile pelias up -d` from the repo
# root — needs none of this; the compose file carries working defaults.

# Must match barrelman's project so the CLI operates on the same stack instead
# of spinning up a second one with clashing container names.
COMPOSE_PROJECT_NAME=barrelman

# Absolute path to the Pelias data dir (Elasticsearch index, downloads, etc.).
# Keep it inside this folder so everything stays under barrelman/pelias.
# Defaults to ./data (i.e. barrelman/pelias/data) when unset.
DATA_DIR=/absolute/path/to/barrelman/pelias/data

# DOCKER_USER is deliberately absent. Recent pelias/docker CLIs derive it from
# the invoking user and print a deprecation warning if you set it anyway:
#   WARNING: The DOCKER_USER env var is deprecated, using 1000:1000.
# That same derivation is why the CLI must be run as a NON-root user — see the
# "Provisioning a fresh server" section of README.md.
