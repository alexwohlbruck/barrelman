{
  "name": "barrelman",
  "version": "0.10.41",
  "description": "OSM geospatial engine — search, tiles, spatial queries, routing",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "test": "bun test",
    "test:integration": "BARRELMAN_INTEGRATION_TESTS=1 bun test src/services/*.integration.test.ts",
    "test:services": "bun test src/services --exclude '*.integration.test.*'",
    "test:routes": "bun test src/routes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "import:boundaries": "bun run scripts/fetch-boundaries.ts",
    "import:osm": "bash scripts/import-osm.sh",
    "import:gtfs": "bash scripts/download-gtfs.sh",
    "import:abbreviations": "bun run import/generate-abbreviations.ts",
    "import:embed": "bun run import/embed-places.ts",
    "landmarks:import": "bun run scripts/import-landmarks.ts",
    "landmarks:import:full": "bun run scripts/import-landmarks.ts --full"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@jsquash/webp": "^1.5.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@polar-sh/sdk": "^0.49.0",
    "@sentry/bun": "^11.10.0",
    "@simplewebauthn/server": "^14.0.3",
    "@turf/turf": "^7.3.4",
    "arctic": "^3.7.0",
    "axios": "^1.21.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "earcut": "^3.2.3",
    "elysia": "^1.4.30",
    "gtfs-realtime-bindings": "^2.0.0",
    "jszip": "^3.10.1",
    "lru-cache": "^11.0.0",
    "lucia": "^3.2.2",
    "nodemailer": "^10.3.1",
    "oslo": "^1.2.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.0"
  }
}
